{
  "name": "@workscribe/cli",
  "version": "1.15.1",
  "description": "Passive developer work journal — automatic terminal activity summaries",
  "type": "commonjs",
  "bin": {
    "workscribe": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "preuninstall": "workscribe uninstall --hooks-only 2>/dev/null; exit 0",
    "prepack": "npm run build",
    "postbuild": "node scripts/postbuild.js",
    "dev": "tsx src/index.ts",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "prepare": "husky",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "files": [
    "dist",
    "shell"
  ],
  "keywords": [
    "developer-tools",
    "journal",
    "terminal",
    "productivity",
    "standup"
  ],
  "author": "Mark Edomwande",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "release-it": "^20.0.1",
    "tsup": "^8.1.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
