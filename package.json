{
  "name": "@kroniql/cli",
  "version": "0.2.0",
  "description": "Passive developer work journal — automatic terminal activity summaries",
  "type": "commonjs",
  "bin": {
    "chronicle": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "postbuild": "chmod +x dist/index.js && node -e \"const fs=require('fs'),p='dist/index.js';fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace('require(\\\"sqlite\\\")', 'require(\\\"node:sqlite\\\")'))\"",
    "dev": "tsx src/index.ts",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "release-it",
    "release:dry": "release-it --dry-run"
  },
  "files": [
    "dist",
    "shell"
  ],
  "keywords": [
    "developer-tools",
    "journal",
    "terminal",
    "productivity",
    "standup"
  ],
  "author": "Mark Edomwande",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "release-it": "^20.0.1",
    "tsup": "^8.1.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
