{
  "name": "@workscribe/cli",
  "version": "1.6.1",
  "description": "Passive developer work journal — automatic terminal activity summaries",
  "type": "commonjs",
  "bin": {
    "workscribe": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "postbuild": "chmod +x dist/index.js && node -e \"const fs=require('fs'),p='dist/index.js';fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/require\\((['\\\"])sqlite\\1\\)/g,'require($1node:sqlite$1)'))\"",
    "dev": "tsx src/index.ts",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "prepare": "husky",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "sync-docs": "node scripts/sync-docs.js ../workscribe-landing-page user-docs"
  },
  "files": [
    "dist",
    "shell"
  ],
  "keywords": [
    "developer-tools",
    "journal",
    "terminal",
    "productivity",
    "standup"
  ],
  "author": "Mark Edomwande",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "release-it": "^20.0.1",
    "tsup": "^8.1.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "optionalDependencies": {
    "better-sqlite3": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
