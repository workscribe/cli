# Workscribe — developer work journal
# Do not edit this file manually. Managed by `workscribe init`.
# workscribe:hook:start
function _workscribe_preexec --on-event fish_preexec
    set -g _workscribe_cmd $argv[1]
    set -g _workscribe_git_before (git rev-parse HEAD 2>/dev/null; or echo "")
end

function _workscribe_postexec --on-event fish_postexec
    set -l exit_code $status
    type -q workscribe
    or return 0
    if set -q _workscribe_cmd; and test -n "$_workscribe_cmd"
        if test -n "$_workscribe_git_before"
            command workscribe _capture \
                --cmd "$_workscribe_cmd" \
                --cwd "$PWD" \
                --exit "$exit_code" \
                --duration "$CMD_DURATION" \
                --git-before "$_workscribe_git_before" \
                > /dev/null 2>&1 &
        else
            command workscribe _capture \
                --cmd "$_workscribe_cmd" \
                --cwd "$PWD" \
                --exit "$exit_code" \
                --duration "$CMD_DURATION" \
                > /dev/null 2>&1 &
        end
        set -e _workscribe_cmd
        set -e _workscribe_git_before
    end
    # Skip the alert check on the first postexec: it fires before the shell
    # has finished initializing, and that output gets mistaken for a startup error.
    if set -q _workscribe_primed; and test -f "$HOME/.workscribe/alerts.pending"
        command workscribe alerts --check
    end
    set -g _workscribe_primed 1
end
# workscribe:hook:end
